@page
@model CouponOps.Pages.Account.LoginModel
@{
    ViewData["Title"] = "로그인";
    Layout = "_Layout";
}
<div class="login-wrap">
    <div class="card">
        <h1>쿠폰 운영툴</h1>

        @if (Model.Error is not null)
        {
            <div class="alert error">@Model.Error</div>
        }

        <form method="post">
            <div class="field">
                <label for="loginId">아이디</label>
                <input id="loginId" name="LoginId" value="@Model.LoginId" autocomplete="username" autofocus required />
            </div>
            <div class="field">
                <label for="password">비밀번호</label>
                <input id="password" name="Password" type="password" autocomplete="current-password" required />
            </div>
            <button class="primary" type="submit">로그인</button>
        </form>

        <p class="seed">로컬 데모 계정 — admin(편집) / viewer(읽기전용)</p>
    </div>
</div>
